# LF everywhere, in the repository and in the working tree. This machine has core.autocrlf=true
# and a Windows checkout would otherwise differ from a Linux one - which matters more here than
# usual, because CI compares hashes of files on disk.
* text=auto eol=lf

# The contract fixtures are bytes, not text: they are meshmaster.dk's exactly, their SHA-256 is in
# MANIFEST.txt, and tools/sync-fixtures.ps1 -Verify compares it. Git must not touch a single one.
tests/fixtures/contracts/*.json -text

# Images and other binaries, for the avoidance of doubt.
*.bin binary
*.elf binary
*.hex -text
