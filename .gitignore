# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
platformio.local.ini

# The ESP-IDF's generated configuration, one per board environment, seeded from the committed
# sdkconfig.defaults (task p1.9-36); and what its component manager would write if it ever ran
sdkconfig.*
!sdkconfig.defaults
dependencies.lock
managed_components/

# What a session leaves behind for a reviewer to read (tasks/README.md: leave the evidence)
out/
tasks/*/logs/
tasks/*/reports/*.draft.md

# Editors and tooling
.vscode/
.idea/
.clangd/
compile_commands.json
cmake-build-*/
*.user
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# The headers tools/pio/release_headers.py writes before every build (task p1.15-58): the trust
# table from keys/release-keys.txt, and the descriptor the image carries about itself.
src/update/generated/

# Python bytecode, from the release tooling run by hand or by a build
__pycache__/
*.pyc
