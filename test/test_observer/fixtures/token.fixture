header={"alg":"Ed25519","typ":"JWT"}
headerB64=eyJhbGciOiJFZDI1NTE5IiwidHlwIjoiSldUIn0
claims1={"publicKey":"7F3A9C02E1B44D9A0F6C2B7D8E9A1C3F5D7B9E0A2C4E6F8A0B1C2D3E4F5A6B7C","aud":"mqtt.meshview.dk","iat":1793016000,"exp":1793102400,"owner":"0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF","client":"meshcore/meshmaster-agent 0.0.0-dev on MeshCore companion-v1.17.1","email":"thomas@example.dk"}

